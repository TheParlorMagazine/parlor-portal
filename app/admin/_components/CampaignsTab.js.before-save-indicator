      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${session.access_token}`,
      },
      body: JSON.stringify({
        to: testEmail.trim(),
        subject,
        html: fullEmailHtml(subject, introHtml, blocks, introBg),
