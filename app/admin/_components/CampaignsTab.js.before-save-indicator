function IntroEditor({ content, onChange, supabase, onUpload, bg, onBgChange }) {
  const [showPicker, setShowPicker] = useState(false)
  const [imgEditing, setImgEditing] = useState(null) // { src }
  const [dropping, setDropping] = useState(false)
  const [dropUploading, setDropUploading] = useState(false)
  const [, forceUpdate] = useState(0)
  const [dragWidth, setDragWidth] = useState(null) // local slider value while dragging

  const editor = useEditor({
    extensions: [
      StarterKit.configure({ heading: { levels: [1,2,3] } }),
      Underline,
      Link.configure({ openOnClick: false }),
      AlignableImage,
    ],
    content: content || '',
    onUpdate: ({ editor }) => onChange(editor.getHTML()),
    onSelectionUpdate: () => forceUpdate(n => n + 1),
    editorProps: {
      attributes: { class: 'cp' },
      handleDrop: (view, event) => {
        const file = event.dataTransfer?.files?.[0]
        if (!file || !file.type.startsWith('image/')) return false
        event.preventDefault()
        setDropping(false)
        setDropUploading(true)
        const fd = new FormData()
        fd.append('file', file)
        fd.append('folder', 'parlor/email')
        onUpload(file)
          .then(url => { if (url) view.dispatch(view.state.tr.replaceSelectionWith(view.state.schema.nodes.image.create({ src: url, 'data-align': 'center' }))) })
          .catch(() => {})
          .finally(() => setDropUploading(false))
        return true
      },
      handleDOMEvents: {
        dragover: (_, e) => { if (e.dataTransfer?.types?.includes('Files')) { e.preventDefault(); setDropping(true) } return false },
        dragleave: () => { setDropping(false); return false },
      },
    },
  })
  useEffect(() => {
    if (editor && content !== undefined && editor.getHTML() !== content)
      editor.commands.setContent(content || '', false)
  }, [editor])
  if (!editor) return null

  const insertImage = () => setShowPicker(true)

  const isImg    = editor.isActive('image')
  const imgAlign = isImg ? (editor.getAttributes('image').align || 'center') : null
  const imgWidth = isImg ? (editor.getAttributes('image').width || null) : null
  const setImgAlign = a => editor.chain().focus().updateAttributes('image', { align: a }).run()
  const setImgWidth = w => editor.chain().focus().updateAttributes('image', { width: w }).run()

  const ALIGN_OPTS = [
    { key: 'left', title: 'Wrap left', icon: <svg width="18" height="12" viewBox="0 0 20 14" fill="none"><rect x="0" y="0" width="7" height="14" rx="1" fill="currentColor" opacity=".9"/><line x1="9.5" y1="2" x2="19.5" y2="2" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="9.5" y1="5.5" x2="19.5" y2="5.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="9.5" y1="9" x2="19.5" y2="9" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="0.5" y1="12.5" x2="19.5" y2="12.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/></svg> },
    { key: 'center', title: 'Center', icon: <svg width="18" height="12" viewBox="0 0 20 14" fill="none"><line x1="0.5" y1="1" x2="19.5" y2="1" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><rect x="4" y="3.5" width="12" height="7" rx="1" fill="currentColor" opacity=".9"/><line x1="0.5" y1="13" x2="19.5" y2="13" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/></svg> },
    { key: 'right', title: 'Wrap right', icon: <svg width="18" height="12" viewBox="0 0 20 14" fill="none"><rect x="13" y="0" width="7" height="14" rx="1" fill="currentColor" opacity=".9"/><line x1="0.5" y1="2" x2="10.5" y2="2" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="0.5" y1="5.5" x2="10.5" y2="5.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="0.5" y1="9" x2="10.5" y2="9" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><line x1="0.5" y1="12.5" x2="19.5" y2="12.5" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/></svg> },
    { key: 'full', title: 'Full width', icon: <svg width="18" height="12" viewBox="0 0 20 14" fill="none"><line x1="0.5" y1="1" x2="19.5" y2="1" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/><rect x="0" y="3.5" width="20" height="7" rx="1" fill="currentColor" opacity=".9"/><line x1="0.5" y1="13" x2="19.5" y2="13" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" opacity=".5"/></svg> },
