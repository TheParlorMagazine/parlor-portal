// ── Blocks serialisation ──────────────────────────────────────────
const MARKER_START = '<!--PARLOR_BLOCKS:'
const MARKER_END   = ':PARLOR_BLOCKS-->'

function encodeBodyHtml(intro, blocks, introBg) {
  const meta = JSON.stringify({ intro, blocks, introBg })
  return MARKER_START + meta + MARKER_END + blocksToEmailHtml(intro, blocks, introBg)
}

function decodeBodyHtml(html) {
  if (!html) return { intro: '', blocks: [], introBg: '#ffffff' }
  const s = html.indexOf(MARKER_START)
  const e = html.indexOf(MARKER_END)
  if (s === -1 || e === -1) return { intro: html, blocks: [], introBg: '#ffffff' }
  try {
    const parsed = JSON.parse(html.slice(s + MARKER_START.length, e))
    return { intro: parsed.intro || '', blocks: parsed.blocks || [], introBg: parsed.introBg || '#ffffff' }
  } catch {
    return { intro: html, blocks: [], introBg: '#ffffff' }
  }
}

