                      onMouseEnter={e => e.currentTarget.style.borderColor = PINK}
                      onMouseLeave={e => e.currentTarget.style.borderColor = 'transparent'}>
                      <img src={a.cover_image_url} alt={a.title} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}

// AlignableImage — inline image with float-based text wrap + width control
// Uses CSS only (no ReactNodeViewRenderer) so drag-to-move and text wrap work natively
const AlignableImage = Image.extend({
  inline: true,
  group: 'inline',
  addAttributes() {
    return {
      ...this.parent?.(),
      align: {
        default: 'center',
        parseHTML: el => el.getAttribute('data-align') || 'center',
        renderHTML: ({ align }) => ({ 'data-align': align }),
      },
      width: {
        default: null,
        parseHTML: el => el.getAttribute('data-width') ? Number(el.getAttribute('data-width')) : null,
        renderHTML: ({ align, width }) => {
          if (!width) return {}
          const defaultW = align === 'full' ? 100 : align === 'center' ? 60 : 45
          return { 'data-width': width, style: `width:${width || defaultW}%` }
        },
      },
    }
  },
})

