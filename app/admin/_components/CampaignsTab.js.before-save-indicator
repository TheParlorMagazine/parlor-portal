function ImagePickerModal({ onPick, onClose, supabase, onUpload }) {
  const [tab, setTab]         = useState('upload')
  const [imageUrl, setImageUrl] = useState('')
  const [urlError, setUrlError] = useState('') // 'upload' | 'library'
  const [dragging, setDragging] = useState(false)
  const [uploading, setUploading] = useState(false)
  const [library, setLibrary]   = useState([])
  const [libLoading, setLibLoading] = useState(false)
  const inputRef = useRef(null)

  useEffect(() => {
    if (tab === 'library' && library.length === 0) {
      setLibLoading(true)
      supabase.from('articles')
        .select('cover_image_url, title')
        .not('cover_image_url', 'is', null)
        .order('date_published', { ascending: false })
        .limit(48)
        .then(({ data }) => {
          const seen = new Set()
          setLibrary((data || []).filter(a => { if (seen.has(a.cover_image_url)) return false; seen.add(a.cover_image_url); return true }))
          setLibLoading(false)
        })
    }
  }, [tab])

  async function uploadFile(file) {
    if (!file || !file.type.startsWith('image/')) return
    setUploading(true)
    try {
      const url = await onUpload(file)
      if (url) onPick(url)
    } catch { alertDialog('Upload failed') }
    setUploading(false)
  }

  const onDrop = e => {
    e.preventDefault(); setDragging(false)
    const file = e.dataTransfer.files[0]
    if (file) uploadFile(file)
  }

  const tabBtn = (id, label) => (
    <button onClick={() => setTab(id)} style={{ padding: '6px 16px', border: 'none', borderBottom: `2px solid ${tab===id ? DP : 'transparent'}`, background: 'none', cursor: 'pointer', fontSize: '12px', fontFamily: ff, color: tab===id ? DP : '#888', fontWeight: tab===id ? '600' : '400' }}>
      {label}
    </button>
  )

  return (
    <div style={{ position: 'fixed', inset: 0, zIndex: 600, background: 'rgba(0,0,0,0.5)', display: 'flex', alignItems: 'center', justifyContent: 'center' }} onClick={onClose}>
      <div style={{ background: '#fff', borderRadius: '12px', width: '640px', maxHeight: '80vh', display: 'flex', flexDirection: 'column', overflow: 'hidden' }} onClick={e => e.stopPropagation()}>
        {/* Header */}
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', padding: '16px 20px', borderBottom: '1px solid #f0f0f0' }}>
          <span style={{ fontFamily: ffH, fontSize: '15px', fontWeight: '700', color: '#0a0a0a' }}>Add Image</span>
          <button onClick={onClose} style={{ background: 'none', border: 'none', color: '#aaa', cursor: 'pointer', fontSize: '18px' }}>✕</button>
        </div>
        {/* Tabs */}
        <div style={{ display: 'flex', borderBottom: '1px solid #f0f0f0', padding: '0 20px' }}>
          {tabBtn('upload', 'Upload')}
          {tabBtn('library', 'Library')}
          {tabBtn('url', 'Image URL')}
        </div>
        {/* Content */}
        <div style={{ flex: 1, overflow: 'auto', padding: '20px' }}>
          {tab === 'upload' && (
            <div>
              {/* Drop zone */}
              <div
                onDragOver={e => { e.preventDefault(); setDragging(true) }}
                onDragLeave={() => setDragging(false)}
                onDrop={onDrop}
                onClick={() => inputRef.current?.click()}
                style={{ border: `2px dashed ${dragging ? DP : '#e0e0e0'}`, borderRadius: '10px', padding: '48px 24px', textAlign: 'center', cursor: 'pointer', background: dragging ? 'rgba(196,54,74,0.04)' : '#fafafa', transition: 'all .15s' }}
              >
                <input ref={inputRef} type="file" accept="image/*" style={{ display: 'none' }} onChange={e => e.target.files[0] && uploadFile(e.target.files[0])} />
                {uploading ? (
                  <p style={{ fontFamily: ff, fontSize: '14px', color: '#888', margin: 0 }}>Uploading…</p>
                ) : (
                  <>
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ccc" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round" style={{ display: 'block', margin: '0 auto 12px' }}><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <p style={{ fontFamily: ff, fontSize: '14px', color: '#888', margin: '0 0 6px' }}>Drag & drop an image here</p>
                    <p style={{ fontFamily: ff, fontSize: '12px', color: '#bbb', margin: 0 }}>or click to browse files</p>
                  </>
                )}
              </div>
            </div>
          )}
          {tab === 'url' && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
              <label style={{ fontFamily: ff, fontSize: '13px', fontWeight: '600' }}>
                Paste an image URL
              </label>
              <input
                type="url"
                value={imageUrl}
                onChange={e => { setImageUrl(e.target.value); setUrlError('') }}
                placeholder="https://res.cloudinary.com/..."
                style={{
                  width: '100%',
                  boxSizing: 'border-box',
                  padding: '12px',
                  border: '1px solid #ddd',
                  borderRadius: '6px',
                  fontFamily: ff,
                  fontSize: '13px'
                }}
              />
